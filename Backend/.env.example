# ==================================================
# EduConsultant Environment Variables
# ==================================================

# Project
PROJECT_NAME=EduConsultant
PROJECT_VERSION=0.1.0
API_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
# MUST BE MySQL connection string compatible with aiomysql
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/educonsultant

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# DO NOT expose SECRET_KEY in production! Generate a strong random key.
SECRET_KEY=lc3vAV68K8zii-d6aWr19q2oMXGszOuZk7RaPuJZ_9s
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
# Comma-separated list or JSON array of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=educonsultant-documents
S3_PRESIGNED_EXPIRY=3600
MAX_UPLOAD_SIZE_MB=10
